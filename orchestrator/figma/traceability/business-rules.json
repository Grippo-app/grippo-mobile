{
  "schemaVersion": 1,
  "rules": [
    {
      "ruleId": "TOK-CAPTURE",
      "domain": "tokens",
      "businessQuestion": "When may bounded node observations update the authoritative observed token catalog?",
      "authority": "Server-issued source plan plus strict node-bound resolved-variable capture",
      "preconditions": ["configured file and branch identity", "durably reserved operation sequence", "complete exact planned source set"],
      "exactInputsRevisions": ["sourceIndexHash", "capture operation/sequence", "capture evidence hash", "fileKeyFingerprint", "branchKey"],
      "decisionTable": [
        { "when": "every planned source validates and aggregation is internally consistent", "then": "publish source shards/index/catalog atomically", "testRef": "orchestrator/figma/tests/observed-token-runner.test.mjs", "testContains": "publication output" },
        { "when": "a source is missing, truncated, degraded, stale, or identity-mismatched", "then": "typed failure; current catalog remains unchanged", "testRef": "orchestrator/figma/tests/observed-token-domain.test.mjs", "testContains": "blocks" }
      ],
      "outputStatusFinding": ["published", "TOKEN_SOURCE_CAPTURE_INVALID", "TOKEN_SOURCE_CAPTURE_INCOMPLETE", "TOKEN_SOURCE_SET_CHANGED"],
      "severity": "blocking on structural failure",
      "allowedNextActions": ["repeat exact capture", "fix access/config"],
      "forbiddenActions": ["infer missing variables", "publish a partial census", "reuse another file or branch"],
      "typedErrors": ["TOKEN_SOURCE_CAPTURE_INVALID", "TOKEN_SOURCE_CAPTURE_INCOMPLETE", "TOKEN_SOURCE_SET_CHANGED"],
      "auditFields": ["sourceIndexHash", "sourceId", "captureOperationId", "captureSequence", "batchSemanticHash", "captureEvidenceHash"],
      "positiveTestIds": ["observed-token-domain valid source", "observed-token-runner atomic publication"],
      "negativeTestIds": ["observed-token-domain truncated capture", "observed-token-runner tampered hash"],
      "stalePartialTestId": "observed-token-runner source-set mismatch",
      "concurrencyTestId": null,
      "uiCopyActionReference": "Design setup/sync session token capture status",
      "taskFinalizationEffect": "No token-origin task may bind an unpublished or incomplete observed coordinate",
      "codeRefs": ["orchestrator/figma/tokens/source-normalizer.mjs", "orchestrator/figma/tokens/catalog-aggregator.mjs", "orchestrator/figma/runtime/run-plan.mjs"],
      "schemaRefs": ["orchestrator/figma/schemas/observed-token-source-capture.schema.json", "orchestrator/figma/schemas/observed-token-source-index.schema.json", "orchestrator/figma/schemas/observed-token-catalog.schema.json"]
    },
    {
      "ruleId": "TOK-ADAPTER",
      "domain": "tokens",
      "businessQuestion": "When is project token absence or drift provable?",
      "authority": "Project-owned strict adapter config and shipped semantic adapter",
      "preconditions": ["enabled token adapter", "contained non-overlapping roots", "complete semantic extraction"],
      "exactInputsRevisions": ["config hash", "adapter version", "Git branch identity", "exact file snapshot hashes"],
      "decisionTable": [
        { "when": "config and complete snapshot validate", "then": "publish per-adapter inventory and analysis index", "testRef": "orchestrator/figma/tests/token-drift-runner.test.mjs", "testContains": "artifacts" },
        { "when": "config is absent", "then": "PROJECT_ADAPTERS_UNCONFIGURED", "testRef": "orchestrator/figma/tests/token-drift-runner.test.mjs", "testContains": "unconfigured" },
        { "when": "roots overlap, Git metadata is unsafe, parse fails, or a limit is hit", "then": "typed invalid/incomplete failure; no absence proof", "testRef": "orchestrator/figma/tests/adapter-contract.test.mjs", "testContains": "overlap" }
      ],
      "outputStatusFinding": ["complete inventory", "PROJECT_ADAPTER_CONFIG_INVALID", "ADAPTER_INPUT_SNAPSHOT_UNSAFE", "PROJECT_TOKEN_INVENTORY_INCOMPLETE"],
      "severity": "blocking for comparison",
      "allowedNextActions": ["fix adapter config", "fix source parse error", "repeat compare"],
      "forbiddenActions": ["heuristic fallback scan", "truncate and claim absence", "mutate project source"],
      "typedErrors": ["PROJECT_ADAPTERS_UNCONFIGURED", "PROJECT_ADAPTER_CONFIG_INVALID", "ADAPTER_INPUT_SNAPSHOT_UNSAFE", "ADAPTER_INPUT_SNAPSHOT_LIMIT"],
      "auditFields": ["configHash", "scopeFingerprint", "snapshotFingerprints", "witness"],
      "positiveTestIds": ["TOK-GEN-RUNNER full artifact set"],
      "negativeTestIds": ["TOK-ADP-OVERLAP", "TOK-ADP-BRANCH malformed"],
      "stalePartialTestId": "TOK-KT incomplete witness",
      "concurrencyTestId": null,
      "uiCopyActionReference": "Design analysis banner adapter configuration action",
      "taskFinalizationEffect": "Incomplete analysis blocks mapping confirmation and token finalization",
      "codeRefs": ["orchestrator/figma/runtime/adapter-config.mjs", "orchestrator/figma/runtime/input-snapshot.mjs", "orchestrator/figma/runtime/project-identity.mjs", "orchestrator/figma/runtime/token-extraction.mjs"],
      "schemaRefs": ["orchestrator/figma/schemas/project-adapters.schema.json", "orchestrator/figma/schemas/project-token-inventory.schema.json"]
    },
    {
      "ruleId": "TOK-LIFECYCLE",
      "domain": "tokens",
      "businessQuestion": "What token status and changed side follow from exact inventories, mapping, and baseline?",
      "authority": "Pure token comparator decision logic",
      "preconditions": ["validated complete inputs", "mapping scope resolution", "eligible baseline or explicit no-baseline"],
      "exactInputsRevisions": ["design inventory hash", "analysis index hash", "mapping hash/revision", "baseline hash", "policy hash"],
      "decisionTable": [
        { "when": "mapped values agree", "then": "matched", "testRef": "orchestrator/figma/tests/token-comparator.test.mjs", "testContains": "matched" },
        { "when": "mapped values disagree", "then": "value-drift with baseline-derived changedSide", "testRef": "orchestrator/figma/tests/token-comparator.test.mjs", "testContains": "value-drift" },
        { "when": "entity is absent without complete same-scope proof", "then": "unknown/blocker, never missing", "testRef": "orchestrator/figma/tests/token-comparator.test.mjs", "testContains": "not-observed" }
      ],
      "outputStatusFinding": ["matched", "value-drift", "missing-in-project", "not-compared", "unbound", "ambiguous-binding", "authority-conflict", "context-map-required", "source-conflict", "unsupported", "not-observed", "ignored"],
      "severity": "finding-dependent",
      "allowedNextActions": ["review mapping", "create exact finding task", "repeat compare"],
      "forbiddenActions": ["auto-confirm suggestion", "infer missing from absent row", "let component inventory affect token fingerprint"],
      "typedErrors": ["TOKEN_COMPARISON_LIMIT_EXCEEDED", "TOKEN_GENERATION_RESYNC_REQUIRED", "TOKEN_SOURCE_FRESHNESS_REQUIRED", "TOKEN_SOURCE_HEALTH_UNAVAILABLE", "TOKEN_SOURCE_REFRESH_FAILED"],
      "auditFields": ["semanticHash", "inputs", "change", "findings", "coverage", "blockers"],
      "positiveTestIds": ["TOK-CMP matched/value drift"],
      "negativeTestIds": ["TOK-ABS absence unproven"],
      "stalePartialTestId": "TOK-CMP no baseline",
      "concurrencyTestId": null,
      "uiCopyActionReference": "Token table/detail status, changed-side and mapping review actions",
      "taskFinalizationEffect": "Only an exact current finding can seed a frozen token binding",
      "codeRefs": ["orchestrator/figma/tokens/comparator.mjs", "orchestrator/figma/tokens/baseline.mjs"],
      "schemaRefs": ["orchestrator/figma/schemas/token-comparison.schema.json", "orchestrator/figma/schemas/token-baseline.schema.json"]
    },
    {
      "ruleId": "CMP-CAPTURE-ADAPTER",
      "domain": "components",
      "businessQuestion": "When are design and project component inventories complete enough for bidirectional comparison?",
      "authority": "Witnessed Figma component census plus shipped semantic project adapter",
      "preconditions": ["stable provider node IDs", "sparse provider-declared variants", "complete project extraction witness"],
      "exactInputsRevisions": ["capture hash", "visual evidence hashes", "config hash", "branch identity", "file snapshot hashes"],
      "decisionTable": [
        { "when": "capture and project extraction are complete", "then": "publish both inventories", "testRef": "orchestrator/figma/tests/component-acceptance.test.mjs", "testContains": "acceptance" },
        { "when": "variant/property identity or visual bytes are invalid", "then": "typed capture failure", "testRef": "orchestrator/figma/tests/component-runner.test.mjs", "testContains": "corrupted visual" },
        { "when": "project scan is partial or unsupported", "then": "block comparison and absence conclusions", "testRef": "orchestrator/figma/tests/component-comparator.test.mjs", "testContains": "incomplete project inventory" }
      ],
      "outputStatusFinding": ["published", "COMPONENT_DESIGN_CAPTURE_INVALID", "COMPONENT_PROJECT_INVENTORY_INCOMPLETE"],
      "severity": "blocking on structural failure",
      "allowedNextActions": ["repeat exact capture", "fix adapter/config", "supply explicit unsupported evidence"],
      "forbiddenActions": ["invent Cartesian variants", "regex fallback", "claim deletion from a partial scan"],
      "typedErrors": ["COMPONENT_DESIGN_CAPTURE_INVALID", "COMPONENT_VARIANT_CAPTURE_INCOMPLETE", "COMPONENT_PROJECT_INVENTORY_INCOMPLETE"],
      "auditFields": ["scopeId", "structuralHash", "visual hashes", "witness", "scopeFingerprint"],
      "positiveTestIds": ["CMP-GEN-RUNNER full artifacts"],
      "negativeTestIds": ["CMP-GEN-RUNNER corrupted visual"],
      "stalePartialTestId": "CMP-CMP-INCOMPLETE",
      "concurrencyTestId": null,
      "uiCopyActionReference": "Component sync/analysis banners",
      "taskFinalizationEffect": "No component binding/finalization may cite incomplete inventories",
      "codeRefs": ["orchestrator/figma/components/capture-normalizer.mjs", "orchestrator/figma/runtime/component-extraction.mjs"],
      "schemaRefs": ["orchestrator/figma/schemas/design-component-inventory.schema.json", "orchestrator/figma/schemas/project-component-inventory.schema.json"]
    },
    {
      "ruleId": "CMP-LIFECYCLE-VISUAL",
      "domain": "components",
      "businessQuestion": "How are semantic/API drift, visual evidence, lifecycle and token causality reported without conflation?",
      "authority": "Pure component comparator and task-suggestion decision functions",
      "preconditions": ["validated component inputs", "exact mapping", "optional exact paired token snapshot"],
      "exactInputsRevisions": ["component inventory hashes", "mapping revision", "baseline hash", "token comparison hash and mapping revision", "policy hash"],
      "decisionTable": [
        { "when": "semantic/API contract agrees", "then": "semantic status matched independently of visual status", "testRef": "orchestrator/figma/tests/component-comparator.test.mjs", "testContains": "visual evidence drift stays on the visual axis" },
        { "when": "visual evidence is absent or external", "then": "insufficient-evidence or not-applicable", "testRef": "orchestrator/figma/tests/component-schemas.test.mjs", "testContains": "full comparator run" },
        { "when": "visual change has exact token causality and no other drift", "then": "underlying-token-change; suppress component task", "testRef": "orchestrator/figma/tests/component-comparator.test.mjs", "testContains": "CMP-17.12" },
        { "when": "semantic/API drift exists", "then": "drifted and exact update-api/add-platform proposal", "testRef": "orchestrator/figma/tests/component-comparator.test.mjs", "testContains": "API drift routes to update-api" }
      ],
      "outputStatusFinding": ["matched", "drifted", "unmapped", "ambiguous", "visual:not-run/not-applicable/insufficient-evidence/matched/review-required/drifted"],
      "severity": "finding-dependent",
      "allowedNextActions": ["review visual contract", "update API", "review mapping", "create exact proposal"],
      "forbiddenActions": ["promote semantic match from pixels", "promote visual match from API", "suppress task without exact token causality"],
      "typedErrors": ["COMPONENT_GENERATION_RESYNC_REQUIRED", "COMPONENT_COMPARISON_LIMIT_EXCEEDED", "COMPONENT_DESIGN_ABSENCE_UNPROVEN"],
      "auditFields": ["semanticHash", "dimensions.visual", "findings", "tokenSnapshot", "change", "proposal dedupKey"],
      "positiveTestIds": ["CMP-CMP-STATUS matched", "CMP-17.12 causality"],
      "negativeTestIds": ["CMP-17.12 missing mapping does not suppress"],
      "stalePartialTestId": "CMP-GEN-RUNNER malformed token pair",
      "concurrencyTestId": null,
      "uiCopyActionReference": "Component row/detail semantic and visual labels",
      "taskFinalizationEffect": "Visual-only review and semantic implementation intents remain distinct",
      "codeRefs": ["orchestrator/figma/components/comparator.mjs", "orchestrator/figma/components/task-suggestions.mjs", "orchestrator/site/scripts/design/components.js"],
      "schemaRefs": ["orchestrator/figma/schemas/component-comparison.schema.json", "orchestrator/figma/schemas/component-task-suggestions.schema.json"]
    },
    {
      "ruleId": "MAP-CONFIRM",
      "domain": "shared-mapping",
      "businessQuestion": "When may an explicit Mapping Review change confirmed authority?",
      "authority": "Project owner action resolved server-side against the current immutable generation",
      "preconditions": ["valid project-owned registry or explicit absent state", "sole writer lease", "exact current identities"],
      "exactInputsRevisions": ["operationId/requestHash", "mapping revision", "design generation manifest hash", "project analysis artifact hash", "comparison semantic hash"],
      "decisionTable": [
        { "when": "all CAS revisions and identities match", "then": "atomically commit registry revision and same-file receipt", "testRef": "orchestrator/site/tests/design-token-mappings.test.mjs", "testContains": "valid confirmation" },
        { "when": "same operationId and same requestHash is retried", "then": "return the committed receipt without a write", "testRef": "orchestrator/site/tests/design-component-mappings.test.mjs", "testContains": "replayed" },
        { "when": "operationId is reused or any CAS revision moved", "then": "typed 409 and atomic no-write", "testRef": "orchestrator/site/tests/design-component-mappings.test.mjs", "testContains": "OPERATION_CONFLICT" },
        { "when": "registry is malformed or semantically corrupt", "then": "block every mutation including onboard-fresh", "testRef": "orchestrator/site/tests/design-component-mappings.test.mjs", "testContains": "CORRUPT" }
      ],
      "outputStatusFinding": ["committed receipt", "mapping conflict", "stale finding", "mapping invalid"],
      "severity": "blocking mutation conflict",
      "allowedNextActions": ["reload exact state", "preserve draft", "recompare", "repair corrupt registry explicitly"],
      "forbiddenActions": ["auto-merge", "auto-confirm suggestion", "recreate corrupt registry", "invent external scope/platform"],
      "typedErrors": ["TOKEN_MAPPING_REVISION_CONFLICT", "COMPONENT_MAPPING_REVISION_CONFLICT", "TOKEN_DESIGN_GENERATION_CONFLICT", "COMPONENT_PROJECT_INVENTORY_CONFLICT", "TOKEN_MAPPING_OPERATION_CONFLICT", "COMPONENT_MAPPING_INVALID"],
      "auditFields": ["operationReceipts", "actor", "timestamp", "reason", "scope identities", "revision"],
      "positiveTestIds": ["TOK-MAP-CAS valid confirmation", "CMP-MAP-CAS valid confirmation"],
      "negativeTestIds": ["mapping operation conflict", "mapping corruption"],
      "stalePartialTestId": "stale design/project/comparison revisions",
      "concurrencyTestId": "mapping writer lease plus durable operation receipt",
      "uiCopyActionReference": "Mapping Review Apply/Retry/Recompare actions",
      "taskFinalizationEffect": "Finalization uses the same registry contract and writer authority; retry never repeats Mapping Review mutation",
      "codeRefs": ["orchestrator/site/server/mapping-mutation.js", "orchestrator/site/server/design-mappings.js", "orchestrator/site/server/design-component-mappings.js"],
      "schemaRefs": ["orchestrator/figma/schemas/token-mappings.schema.json", "orchestrator/figma/schemas/component-mappings.schema.json"]
    },
    {
      "ruleId": "COMPARE-LOCAL-GEN-PUBLISH",
      "domain": "shared-runtime",
      "businessQuestion": "When may local comparison outputs become the current coherent generation?",
      "authority": "Server-owned fixed child runner plus immutable generation publisher",
      "preconditions": ["exact plan/start snapshot", "validated complete stage", "writer lease", "pre-publish fingerprint recheck"],
      "exactInputsRevisions": ["domain input fingerprint", "active manifest hash", "config/mapping/file hashes", "runner result artifact hashes"],
      "decisionTable": [
        { "when": "stage validates and input fingerprint is unchanged", "then": "publish whole domain and switch pointer last", "testRef": "orchestrator/site/tests/figma-integration-contracts.test.mjs", "testContains": "generation" },
        { "when": "input changes before publish", "then": "discard stage and return typed stale failure", "testRef": "orchestrator/site/tests/figma-integration-contracts.test.mjs", "testContains": "input" },
        { "when": "runner fails or paired cross-domain snapshot is invalid", "then": "leave current pointer unchanged", "testRef": "orchestrator/figma/tests/component-runner.test.mjs", "testContains": "malformed or unpaired token" }
      ],
      "outputStatusFinding": ["completed generation", "partial domain error", "input changed", "resync required"],
      "severity": "blocking publication failure",
      "allowedNextActions": ["retry exact compare", "resync incompatible generation", "fix config/source"],
      "forbiddenActions": ["publish partial required roles", "mix old/new domain artifacts", "write pointer before artifacts"],
      "typedErrors": ["TOKEN_COMPARISON_INPUT_CHANGED", "TOKEN_GENERATION_RESYNC_REQUIRED", "COMPONENT_GENERATION_RESYNC_REQUIRED"],
      "auditFields": ["jobId", "inputFingerprint", "generationId", "manifestHash", "artifact roles/hashes"],
      "positiveTestIds": ["token/component runner full artifact set"],
      "negativeTestIds": ["runner typed failures"],
      "stalePartialTestId": "publish-time fingerprint recheck",
      "concurrencyTestId": "writer lease publication race tests",
      "uiCopyActionReference": "Compare job status/history and analysis banner",
      "taskFinalizationEffect": "Post-finalization enqueue occurs only after commit/lease release",
      "codeRefs": ["orchestrator/figma/runtime/run-plan.mjs", "orchestrator/site/server/figma-token-jobs.js", "orchestrator/site/server/figma-generation.js", "orchestrator/site/server/figma-sync.js"],
      "schemaRefs": ["orchestrator/figma/token-schemas/generation-manifest.schema.json"]
    },
    {
      "ruleId": "TASK-FINALIZE-MAPPING",
      "domain": "tasks",
      "businessQuestion": "When may a design-origin task finish and publish its confirmed mapping effect?",
      "authority": "Frozen machine binding, exact current generation, finalization journal and sole writer authority",
      "preconditions": ["canonical task/run/session", "frozen evidence hash", "fresh exact design/project identities", "validation compare passes"],
      "exactInputsRevisions": ["task sourceId", "binding evidence hash", "generation revision", "mapping revision", "project inventory revision", "run/finalization identity"],
      "decisionTable": [
        { "when": "binding and all pinned inputs remain exact", "then": "transactionally publish task state and mapping", "testRef": "orchestrator/tasks/tests/test-finalize-task.mjs", "testContains": "mapping" },
        { "when": "binding, generation, registry, or project inventory is stale", "then": "typed stale/block; no partial task or mapping write", "testRef": "orchestrator/tasks/tests/test-finalize-task.mjs", "testContains": "stale" },
        { "when": "crash occurs across canonical mutation", "then": "journal recovers to old or fully committed state", "testRef": "orchestrator/tasks/tests/test-finalize-task.mjs", "testContains": "recovery" }
      ],
      "outputStatusFinding": ["finalized", "binding stale", "mapping conflict", "recovery required"],
      "severity": "blocking finalization failure",
      "allowedNextActions": ["refresh binding through explicit task flow", "retry exact finalization", "run recovery"],
      "forbiddenActions": ["complete task with old mapping", "publish mapping before validation", "rollback over foreign writer"],
      "typedErrors": ["TOKEN_TASK_BINDING_STALE", "COMPONENT_TASK_BINDING_STALE", "TOKEN_MAPPING_PUBLICATION_RECOVERY_REQUIRED", "COMPONENT_MAPPING_PUBLICATION_RECOVERY_REQUIRED"],
      "auditFields": ["taskStem", "runId", "sessionId", "finalization marker", "before/after hashes"],
      "positiveTestIds": ["finalize token/component mapping"],
      "negativeTestIds": ["stale binding/finding"],
      "stalePartialTestId": "finalization revision conflict",
      "concurrencyTestId": "finalization writer lease and recovery tests",
      "uiCopyActionReference": "Task finalization status and actionable failure copy",
      "taskFinalizationEffect": "This rule owns the finalization effect",
      "codeRefs": ["orchestrator/tasks/finalize-task.mjs", "orchestrator/tasks/component-binding-contract.cjs", "orchestrator/figma/tokens/mapping-contract.mjs"],
      "schemaRefs": ["orchestrator/figma/schemas/token-task-binding.schema.json", "orchestrator/figma/schemas/component-task-binding.schema.json"]
    },
    {
      "ruleId": "RECOVER-WRITER-UI",
      "domain": "shared-runtime-ui",
      "businessQuestion": "How do recovery and UI expose exact machine state without taking ownership from another writer?",
      "authority": "Exact writer/publication markers and backend-projected status/action contracts",
      "preconditions": ["validated marker identity", "owner liveness/generation proof", "current generation snapshot"],
      "exactInputsRevisions": ["owner and process generation", "marker hashes/phases", "generation revision", "job revision"],
      "decisionTable": [
        { "when": "owner is live or identity is ambiguous", "then": "preserve lease/state and report busy/actionable", "testRef": "orchestrator/tasks/tests/test-writer-lease-recovery.mjs", "testContains": "preserves" },
        { "when": "dead owner and exact marker reconciliation are proven", "then": "recover exact phase only", "testRef": "orchestrator/tasks/tests/test-writer-lease-recovery.mjs", "testContains": "recover" },
        { "when": "backend status is stale/invalid/incomplete", "then": "UI shows matching banner and only backend-authorized actions", "testRef": "orchestrator/site/tests/design-contracts.test.mjs", "testContains": "action" }
      ],
      "outputStatusFinding": ["busy", "recovered", "recovery-required", "current/stale/invalid UI projection"],
      "severity": "blocking integrity failure; actionable UI warning otherwise",
      "allowedNextActions": ["wait", "exact retry", "owner-reviewed recovery", "resync/recompare"],
      "forbiddenActions": ["age-based clear", "release foreign lease", "UI-side status recomputation", "duplicate ownership actions"],
      "typedErrors": ["writer-busy", "publication-recovery-required", "design-generation-conflict"],
      "auditFields": ["owner", "generation", "phase", "hashes", "backend status/action", "localized copy key"],
      "positiveTestIds": ["writer recovery exact", "design UI projection"],
      "negativeTestIds": ["foreign/live/ambiguous owner preserved"],
      "stalePartialTestId": "startup reconciliation incompatible generation",
      "concurrencyTestId": "writer lease recovery race suite",
      "uiCopyActionReference": "Design analysis banners, job state, retry/recompare/resync controls",
      "taskFinalizationEffect": "Recovery never fabricates a completed task or mapping",
      "codeRefs": ["orchestrator/tasks/writer-leases.cjs", "orchestrator/site/server/design-catalog.js", "orchestrator/site/scripts/design/analysis-banner.js"],
      "schemaRefs": ["orchestrator/figma/token-schemas/generation-manifest.schema.json"]
    }
  ]
}
