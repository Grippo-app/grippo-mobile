{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bootstrapper-orchestrator.local/figma/generation-manifest.schema.json",
  "title": "Figma artifact generation manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generationId",
    "accountFingerprint",
    "fileKeyFingerprint",
    "createdAt",
    "syncJobId",
    "updatedDomains",
    "syncGroups",
    "groups",
    "domains",
    "artifacts",
    "counters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generationId": {
      "$ref": "#/definitions/generationId"
    },
    "accountFingerprint": {
      "$ref": "#/definitions/hash"
    },
    "fileKeyFingerprint": {
      "$ref": "#/definitions/hash"
    },
    "createdAt": {
      "$ref": "#/definitions/instant"
    },
    "syncJobId": {
      "type": "string",
      "pattern": "^fsj-[a-f0-9]{32}$"
    },
    "updatedDomains": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/definitions/domainId"
      }
    },
    "syncGroups": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 4,
      "properties": {
        "tokens": {
          "$ref": "#/definitions/syncGroup"
        },
        "components": {
          "$ref": "#/definitions/syncGroup"
        },
        "surfaces": {
          "$ref": "#/definitions/syncGroup"
        },
        "drift": {
          "$ref": "#/definitions/syncGroup"
        }
      }
    },
    "groups": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/group"
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "inputFingerprint",
          "syncedAt",
          "sourceGenerationId"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/domainId"
          },
          "group": {
            "$ref": "#/definitions/group"
          },
          "inputFingerprint": {
            "$ref": "#/definitions/hash"
          },
          "syncedAt": {
            "$ref": "#/definitions/instant"
          },
          "sourceGenerationId": {
            "$ref": "#/definitions/generationId"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "group",
          "domain",
          "path",
          "logicalPath",
          "hash",
          "schemaVersion",
          "persistence",
          "required",
          "size"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "group": {
            "$ref": "#/definitions/group"
          },
          "domain": {
            "$ref": "#/definitions/domainId"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "logicalPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "hash": {
            "$ref": "#/definitions/hash"
          },
          "schemaVersion": {
            "const": 1
          },
          "persistence": {
            "enum": [
              "committed",
              "runtime"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "required": {
                  "const": true
                }
              },
              "required": [
                "required"
              ]
            },
            "then": {
              "properties": {
                "persistence": {
                  "const": "committed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "domain": {
                  "const": "tokens"
                }
              },
              "required": [
                "domain"
              ]
            },
            "then": {
              "properties": {
                "group": {
                  "const": "tokens"
                },
                "logicalPath": {
                  "type": "string",
                  "pattern": "^orchestrator/figma/tokens/"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "domain": {
                  "const": "token-drift"
                }
              },
              "required": [
                "domain"
              ]
            },
            "then": {
              "properties": {
                "group": {
                  "const": "drift"
                },
                "logicalPath": {
                  "type": "string",
                  "pattern": "^orchestrator/\\.cache/figma/reports/token-comparison/"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "domain": {
                  "const": "components"
                }
              },
              "required": [
                "domain"
              ]
            },
            "then": {
              "properties": {
                "group": {
                  "const": "components"
                },
                "logicalPath": {
                  "type": "string",
                  "pattern": "^orchestrator/figma/components/"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "domain": {
                  "const": "component-drift"
                }
              },
              "required": [
                "domain"
              ]
            },
            "then": {
              "properties": {
                "group": {
                  "const": "drift"
                },
                "logicalPath": {
                  "type": "string",
                  "pattern": "^orchestrator/\\.cache/figma/reports/component-comparison/"
                }
              }
            }
          }
        ]
      }
    },
    "counters": {
      "$ref": "#/definitions/counters"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "updatedDomains": {
            "type": "array",
            "contains": {
              "const": "tokens"
            }
          }
        },
        "required": [
          "updatedDomains"
        ]
      },
      "then": {
        "properties": {
          "domains": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "id": {
                  "const": "tokens"
                },
                "group": {
                  "const": "tokens"
                }
              },
              "required": [
                "id",
                "group"
              ]
            }
          },
          "syncGroups": {
            "type": "object",
            "required": [
              "tokens"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "updatedDomains": {
            "type": "array",
            "contains": {
              "const": "components"
            }
          }
        },
        "required": [
          "updatedDomains"
        ]
      },
      "then": {
        "properties": {
          "domains": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "id": {
                  "const": "components"
                },
                "group": {
                  "const": "components"
                }
              },
              "required": [
                "id",
                "group"
              ]
            }
          },
          "syncGroups": {
            "type": "object",
            "required": [
              "components"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "updatedDomains": {
            "type": "array",
            "contains": {
              "const": "drift"
            }
          }
        },
        "required": [
          "updatedDomains"
        ]
      },
      "then": {
        "properties": {
          "domains": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "id": {
                  "const": "drift"
                },
                "group": {
                  "const": "drift"
                }
              },
              "required": [
                "id",
                "group"
              ]
            }
          },
          "syncGroups": {
            "type": "object",
            "required": [
              "drift"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "group": {
                  "const": "tokens"
                }
              },
              "required": [
                "group"
              ]
            }
          }
        },
        "required": [
          "artifacts"
        ]
      },
      "then": {
        "properties": {
          "groups": {
            "type": "array",
            "contains": {
              "const": "tokens"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "group": {
                  "const": "components"
                }
              },
              "required": [
                "group"
              ]
            }
          }
        },
        "required": [
          "artifacts"
        ]
      },
      "then": {
        "properties": {
          "groups": {
            "type": "array",
            "contains": {
              "const": "components"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "group": {
                  "const": "surfaces"
                }
              },
              "required": [
                "group"
              ]
            }
          }
        },
        "required": [
          "artifacts"
        ]
      },
      "then": {
        "properties": {
          "groups": {
            "type": "array",
            "contains": {
              "const": "surfaces"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "group": {
                  "const": "drift"
                }
              },
              "required": [
                "group"
              ]
            }
          }
        },
        "required": [
          "artifacts"
        ]
      },
      "then": {
        "properties": {
          "groups": {
            "type": "array",
            "contains": {
              "const": "drift"
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "generationId": {
      "type": "string",
      "pattern": "^gen-[a-f0-9]{32}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "group": {
      "enum": [
        "tokens",
        "components",
        "surfaces",
        "drift"
      ]
    },
    "domainId": {
      "type": "string",
      "pattern": "^(?:tokens|components|token-drift|component-drift|surface:[a-z0-9][a-z0-9_-]{0,119}|surface-drift:[a-z0-9][a-z0-9_-]{0,119})$"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updated",
        "unchanged",
        "warnings"
      ],
      "properties": {
        "updated": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "syncGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "updated",
        "unchanged",
        "warnings"
      ],
      "properties": {
        "status": {
          "const": "completed"
        },
        "updated": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
