{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScreenCacheReport",
  "allOf": [
    { "$ref": "report-envelope.schema.json" },
    {
      "type": "object",
      "required": ["screens"],
      "properties": {
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["screen", "status"],
            "additionalProperties": false,
            "properties": {
              "screen": { "type": "string" },
              "status": { "enum": ["complete", "incomplete", "missing", "stale"] },
              "themes": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["expectedNodeId", "actualNodeId"],
                  "properties": {
                    "expectedNodeId": { "type": "string", "minLength": 1 },
                    "actualNodeId": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
