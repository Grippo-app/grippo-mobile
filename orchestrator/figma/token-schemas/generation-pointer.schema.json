{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bootstrapper-orchestrator.local/figma/generation-pointer.schema.json",
  "title": "Figma current generation pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generationId", "manifestHash", "committedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generationId": { "type": "string", "pattern": "^gen-[a-f0-9]{32}$" },
    "manifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "committedAt": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" }
  }
}
