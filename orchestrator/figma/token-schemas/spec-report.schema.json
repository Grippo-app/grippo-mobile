{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecReport",
  "allOf": [
    { "$ref": "report-envelope.schema.json" },
    {
      "type": "object",
      "required": ["mode", "screens"],
      "properties": {
        "mode": { "const": "gate" },
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["screen", "verdict"],
            "additionalProperties": false,
            "properties": {
              "screen": { "type": "string", "minLength": 1 },
              "verdict": { "enum": ["PASS", "FAIL"] },
              "note": { "type": "string" },
              "minors": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  ]
}
