{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestrator/api-contract/contract-schemas/generation-pointer.schema.json",
  "title": "Current backend contract generation pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generationId", "manifestHash", "committedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generationId": { "type": "string", "pattern": "^gen-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$" },
    "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "committedAt": { "type": "string", "format": "date-time" }
  }
}
