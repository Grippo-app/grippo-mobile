{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestrator/api-contract/contract-schemas/credential-state.schema.json",
  "title": "Non-secret backend credential revision state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revisions", "fileProofs", "idempotency"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "enum": ["local", "dev", "stage", "prod"] },
      "patternProperties": {
        "^(local|dev|stage|prod)$": { "type": "integer", "minimum": 0 }
      }
    },
    "fileProofs": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "enum": ["local", "dev", "stage", "prod"] },
      "patternProperties": {
        "^(local|dev|stage|prod)$": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "idempotency": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "fingerprint", "environmentId", "revision", "createdAt"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
          "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "environmentId": { "enum": ["local", "dev", "stage", "prod"] },
          "revision": { "type": "integer", "minimum": 0 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
