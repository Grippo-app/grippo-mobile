{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestrator/api-contract/contract-schemas/implementation-map.schema.json",
  "title": "Generation-bound project API implementation map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analyzerVersion",
    "committedGenerationId",
    "contractHash",
    "environmentId",
    "projectCodeRevision",
    "generatedAt",
    "analysisStatus",
    "coverage",
    "receipt",
    "operations",
    "unresolved",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analyzerVersion": { "type": "string", "pattern": "^api-project-analyzer-v[1-9][0-9]*$" },
    "committedGenerationId": {
      "type": "string",
      "pattern": "^gen-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$"
    },
    "contractHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "environmentId": { "enum": ["local", "dev", "stage", "prod"] },
    "projectCodeRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "analysisStatus": { "enum": ["complete", "partial"] },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "implemented", "missing", "partial", "unknown", "analyzedFiles"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "implemented": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "missing": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "partial": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unknown": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "analyzedFiles": { "type": "integer", "minimum": 0, "maximum": 20000 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "totalBytes", "directoryCount", "files"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "totalBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "directoryCount": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "files": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "hash"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              },
              "size": { "type": "integer", "minimum": 0, "maximum": 2097152 },
              "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/definitions/operation" }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "reason", "candidates"],
        "properties": {
          "operationId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "reason": { "enum": ["ambiguous-mapping", "heuristic-only"] },
          "candidates": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/definitions/candidate" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  },
  "definitions": {
    "path": {
      "type": ["string", "null"],
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "requiredPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "symbol", "confidence"],
      "properties": {
        "file": { "$ref": "#/definitions/requiredPath" },
        "symbol": { "type": ["string", "null"], "maxLength": 300 },
        "confidence": { "enum": ["exact", "derived", "heuristic"] }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "state", "file", "symbol", "confidence", "evidence"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "state": { "enum": ["implemented", "missing", "partial", "unknown"] },
        "file": { "$ref": "#/definitions/path" },
        "symbol": { "type": ["string", "null"], "maxLength": 300 },
        "confidence": { "enum": ["exact", "derived", "heuristic", null] },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
