{
  "openapi": "3.1.0",
  "info": {
    "title": "Sample Notes API",
    "version": "1.0.0",
    "description": "Committed fixture for the contract pipeline — exercised by contract:test through the typed sidecar. Not a real backend. NoteResponse.updated_at is deliberately declared non-nullable while postman.sample.json observes it as null (the spec-lie case)."
  },
  "tags": [
    { "name": "auth", "description": "Token issuance" },
    { "name": "notes", "description": "Notes CRUD" },
    { "name": "notifications", "description": "User notifications" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "operationId": "login",
        "summary": "Issue a token pair",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginBody" } }
          }
        },
        "responses": {
          "200": {
            "description": "Token pair",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthTokenResponse" } }
            }
          },
          "401": { "description": "Bad credentials" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "operationId": "refreshToken",
        "summary": "Rotate the token pair",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshBody" } }
          }
        },
        "responses": {
          "200": {
            "description": "Fresh token pair",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthTokenResponse" } }
            }
          },
          "401": { "description": "Refresh token expired" }
        }
      }
    },
    "/notes": {
      "get": {
        "tags": ["notes"],
        "operationId": "listNotes",
        "summary": "List the user's notes",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "maximum": 100 } },
          { "name": "search", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Page of notes",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/NoteResponse" } }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "tags": ["notes"],
        "operationId": "createNote",
        "summary": "Create a note",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateNoteBody" } }
          }
        },
        "responses": {
          "201": {
            "description": "Created note",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/NoteResponse" } }
            }
          },
          "400": { "description": "Validation failed" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/notes/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "tags": ["notes"],
        "operationId": "getNote",
        "summary": "Fetch one note",
        "responses": {
          "200": {
            "description": "The note",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/NoteResponse" } }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["notifications"],
        "summary": "List user notifications (no operationId on purpose — exercises canonical derivation)",
        "responses": {
          "200": {
            "description": "Notifications, newest first",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserNotificationResponse" } }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "LoginBody": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "RefreshBody": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string" }
        }
      },
      "AuthTokenResponse": {
        "type": "object",
        "required": ["access_token", "refresh_token", "expires_in"],
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "expires_in": { "type": "integer", "format": "int32" }
        }
      },
      "CreateNoteBody": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "maxLength": 200 },
          "content": { "type": ["string", "null"] },
          "kind": { "type": "string", "enum": ["PERSONAL", "WORK", "ARCHIVE"] }
        }
      },
      "NoteResponse": {
        "type": "object",
        "required": ["id", "title", "kind", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "content": { "type": ["string", "null"] },
          "kind": { "type": "string", "enum": ["PERSONAL", "WORK", "ARCHIVE"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "UserNotificationResponse": {
        "type": "object",
        "required": ["id", "kind", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "kind": { "type": "string", "enum": ["INFO", "WARN", "SYSTEM"] },
          "read": { "type": ["boolean", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "note": { "$ref": "#/components/schemas/NoteResponse" }
        }
      }
    }
  }
}
