{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "task.prep payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "stem"],
  "properties": {
    "operation": { "const": "task.prep" },
    "stem": { "type": "string", "pattern": "^TASK_[0-9]+_[a-z0-9_]+$", "maxLength": 120 },
    "mode": { "type": "string", "enum": ["skills"] },
    "answers": { "type": "string", "maxLength": 20000 },
    "selectedIds": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 200 }
  }
}
