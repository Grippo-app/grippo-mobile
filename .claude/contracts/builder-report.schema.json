{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bootstrapper-orchestrator.local/contracts/builder-report.schema.json",
  "title": "Current builder report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agent",
    "status",
    "files_touched",
    "produced_signatures",
    "blockers",
    "assumptions",
    "scope_deviations",
    "handoff",
    "developer_runs",
    "additional_impact_found"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "agent": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "done",
        "blocked",
        "failed",
        "skipped"
      ]
    },
    "files_touched": {
      "$ref": "#/$defs/paths"
    },
    "produced_signatures": {
      "$ref": "#/$defs/strings"
    },
    "blockers": {
      "$ref": "#/$defs/strings"
    },
    "assumptions": {
      "$ref": "#/$defs/strings"
    },
    "scope_deviations": {
      "$ref": "#/$defs/strings"
    },
    "handoff": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        ]
      }
    },
    "developer_runs": {
      "$ref": "#/$defs/strings"
    },
    "additional_impact_found": {
      "$ref": "#/$defs/strings"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
      }
    }
  }
}
